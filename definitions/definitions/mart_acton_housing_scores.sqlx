config {
  type: "table",
  schema: "uk_housing_acton",
  name: "mart_acton_housing_scores_final",
  description: "アクトン地区のポストコード単位における住宅環境スコア、月額想定光熱費、ペルソナ別総合スコアを含むマートテーブル",
  tags: ["mart", "housing", "scores"]
}

WITH current_mart AS (
  SELECT
    *
  FROM
    `project-f9b55fc0-cc37-44aa-bca.uk_housing_acton.mart_acton_housing_scores`
),

calculated_features AS (
  SELECT
    postcode,

    -- 1. 想定月額エネルギーコスト算出
    ROUND(
      CASE
        WHEN avg_epc_efficiency_score >= 81 THEN 140
        WHEN avg_epc_efficiency_score >= 69 THEN 180
        WHEN avg_epc_efficiency_score >= 55 THEN 250
        WHEN avg_epc_efficiency_score >= 39 THEN 350
        ELSE 420
      END,
      0
    ) AS estimated_monthly_energy_cost_gbp,

    -- 2. 各指標の標準化スコア（0〜100点換算）
    CASE
      WHEN mins_to_bond_street <= 20 THEN 100.0
      WHEN mins_to_bond_street >= 40 THEN 0.0
      ELSE 100.0 - ((mins_to_bond_street - 20) * 5.0)
    END AS score_transit,

    CASE
      WHEN dist_to_station_m <= 300 THEN 100.0
      WHEN dist_to_station_m >= 1200 THEN 0.0
      ELSE 100.0 - ((dist_to_station_m - 300) / 9.0)
    END AS score_station_dist,

    CASE
      WHEN dist_to_japanese_poi_m <= 300 THEN 100.0
      WHEN dist_to_japanese_poi_m >= 1500 THEN 0.0
      ELSE 100.0 - ((dist_to_japanese_poi_m - 300) / 12.0)
    END AS score_japanese_poi,

    CASE
      WHEN dist_to_nearest_supermarket_m <= 200 THEN 100.0
      WHEN dist_to_nearest_supermarket_m >= 800 THEN 0.0
      ELSE 100.0 - ((dist_to_nearest_supermarket_m - 200) / 6.0)
    END AS score_supermarket,

    CASE
      WHEN crime_count_500m <= 50 THEN 100.0
      WHEN crime_count_500m >= 300 THEN 0.0
      ELSE 100.0 - ((crime_count_500m - 50) / 2.5)
    END AS score_safety,

    CASE
      WHEN avg_epc_efficiency_score >= 100 THEN 100.0
      WHEN avg_epc_efficiency_score <= 0 THEN 0.0
      ELSE CAST(avg_epc_efficiency_score AS FLOAT64)
    END AS score_epc

  FROM
    current_mart
)

SELECT
  -- 元のテーブルのカラムをすべてそのまま展開
  m.*,

  -- 光熱費の推計値
  f.estimated_monthly_energy_cost_gbp,

  -- 各要素の標準化スコア（0〜100点）
  ROUND(f.score_transit, 1) AS score_transit,
  ROUND(f.score_station_dist, 1) AS score_station_dist,
  ROUND(f.score_japanese_poi, 1) AS score_japanese_poi,
  ROUND(f.score_supermarket, 1) AS score_supermarket,
  ROUND(f.score_safety, 1) AS score_safety,
  ROUND(f.score_epc, 1) AS score_epc,

  -- 1. DINKS / 単身世帯向けスコア
  ROUND(
    (f.score_transit * 0.35) +
    (f.score_station_dist * 0.25) +
    (f.score_supermarket * 0.20) +
    (f.score_safety * 0.10) +
    (f.score_epc * 0.10),
    1
  ) AS score_dinks,

  -- 2. 未就学児〜低学年ファミリー世帯向けスコア
  ROUND(
    (f.score_japanese_poi * 0.35) +
    (f.score_safety * 0.25) +
    (f.score_epc * 0.15) +
    (f.score_supermarket * 0.15) +
    (f.score_transit * 0.10),
    1
  ) AS score_family_young,

  -- 3. 中高生・複数子ファミリー世帯向けスコア
  ROUND(
    (f.score_station_dist * 0.25) +
    (f.score_safety * 0.25) +
    (f.score_epc * 0.20) +
    (f.score_transit * 0.15) +
    (f.score_japanese_poi * 0.15),
    1
  ) AS score_family_senior

FROM
  current_mart AS m
INNER JOIN
  calculated_features AS f
  ON m.postcode = f.postcode